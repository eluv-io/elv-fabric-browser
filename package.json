{
  "version": "3.0.24",
  "bugs": {
    "url": "https://github.com/eluv-io/elv-fabric-browser/issues"
  },
  "homepage": "https://github.com/eluv-io/elv-fabric-browser",
  "repository": "https://github.com/eluv-io/elv-fabric-browser",
  "license": "MIT",
  "scripts": {
    "bump-version": "npm --git-tag-version --no-commit-hooks version patch",
    "serve": "rm -rf node_modules/.vite; vite",
    "build": "rm -rf dist/* ; vite build",
    "build-analyze": "rm -rf dist/* ; ANALYZE_BUNDLE=true vite build",
    "lint": "npm run lint-scss-fix ; npm run lint-scss ; npm run fix-js",
    "lint-show": "npm run lint-scss ; npm run lint-js",
    "lint-js": "./node_modules/.bin/eslint \"src/**/*.js\"",
    "fix-js": "npm run lint-js -- --fix",
    "lint-scss": "npx stylelint \"src/**/*.{css,scss}\"",
    "lint-scss-fix": "npx stylelint \"src/**/*.{css,scss}\" --fix"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ],
  "dependencies": {
    "@eluvio/elv-client-js": "^4.2.46",
    "bignumber.js": "^8.1.1",
    "browser-cancelable-events": "^1.0.1",
    "browser-solc": "^1.0.0",
    "diff": "^5.0.0",
    "luxon": "^1.25.0",
    "mobx": "^7.1.7",
    "mobx-react": "^10.0.4",
    "node-fetch": "^2.6.7",
    "path": "^0.12.7",
    "pretty-bytes": "^5.1.0",
    "prop-types": "^15.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "url-join": "^6.0.0",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^9.4.9",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "sass": "^1.108.2",
    "sass-embedded": "^1.108.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.3",
    "vite": "^8.3.8",
    "vite-plugin-static-copy": "^4.1.1"
  }
}
